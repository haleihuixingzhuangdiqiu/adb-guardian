<resources>
    <string name="app_name">ADB 守护</string>
    <string name="subtitle">让测试机随时就绪</string>
    <string name="state_idle">尚未开始守护</string>
    <string name="state_help">首次授权后，自动检查并尝试恢复无线调试。</string>
    <string name="start">开始守护</string>
    <string name="stop">停止守护</string>
    <string name="retry">确认后重试</string>
    <string name="restart">重新开始守护</string>
    <string name="wireless_settings">打开无线调试设置</string>
    <string name="setup_title">首次配置</string>
    <string name="setup_body">1. 在系统无线调试中允许当前网络，并勾选“始终允许”。\n2. 与电脑完成无线配对。\n3. 从已连接的电脑执行下方授权命令，再开始守护。USB 可逐台临时连接。</string>
    <string name="copy_command">复制授权命令</string>
    <string name="permission_command" translatable="false">adb -s \"DEVICE_SERIAL\" shell pm grant dev.local.adbguardian android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="command_hint">把 DEVICE_SERIAL 换成 adb devices 中这台手机的标识。授权若被系统拒绝，需要针对机型处理。</string>
    <string name="power_title">长期放置</string>
    <string name="keep_awake">充电时加强保活</string>
    <string name="power_help">熄屏后保持 CPU 唤醒；拔下充电器后释放。可能增加耗电和温度，不适合电池与后台行为测试。</string>
    <string name="background_settings">查看后台运行设置</string>
    <string name="background_help">iQOO / vivo 请在系统中允许本应用自启动、后台运行。强行停止或厂商清理后，可能需要重新打开本应用。</string>
    <string name="scope_help">本应用只管理无线调试开关。电脑是否在线、配对是否有效，请由电脑端确认。开关开启并不等于 ADB 已连接。停止守护会停止自动恢复，保留现有无线调试设置。</string>
    <string name="events_title">最近事件</string>
    <string name="no_events">暂无事件</string>
    <string name="channel_name">无线调试守护</string>
    <string name="channel_description">显示守护状态，并可随时停止。</string>
    <string name="notification_stop">停止</string>
    <string name="permission_required">尚未完成一次性授权，请先完成下方配置。</string>
    <string name="copied">已复制；请替换 DEVICE_SERIAL</string>
    <string name="settings_unavailable">系统未提供此设置入口，请在手机设置中查找。</string>
    <string name="background_dialog_title">允许后台运行</string>
    <string name="background_dialog_body">在 iQOO / vivo 系统中，为“ADB 守护”开启自启动并允许后台高耗电；如有电池优化选项，可单独允许本应用。只调整本应用即可。</string>
    <string name="app_settings">打开应用设置</string>
    <string name="cancel">返回</string>
</resources>
